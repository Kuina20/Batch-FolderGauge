<Window x:Class="BatchFolderGauge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:BatchFolderGauge.Core;assembly=BatchFolderGauge.Core"
        Title="Batch FolderGauge · 文件夹大小统计" Width="1240" Height="800"
        MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="6"/><RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="文件夹大小统计" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="批量查看本地磁盘与 SMB 共享文件夹的大小" Foreground="#63758D" Margin="0,6,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16" LastChildFill="False">
            <Button Content="导出 CSV" DockPanel.Dock="Right" Click="ExportCsv" IsEnabled="{Binding CanExport}" Margin="0"/>
            <Button Content="选择文件夹…" Click="AddFolders" IsEnabled="{Binding IsEditable}"/>
            <Button Content="粘贴路径…" Click="PastePaths" IsEnabled="{Binding IsEditable}"/>
            <Button Content="移除选中" Click="RemoveSelected" IsEnabled="{Binding CanRemove}"/>
            <Button Content="清空" Command="{Binding ClearCommand}"/>
            <Button Content="开始统计" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"/>
            <Button Content="取消" Command="{Binding CancelCommand}"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <Border Background="#E8EFFC" BorderBrush="#D3DFF6" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" Foreground="#405A81"
                           Text="优先扫描深层路径，父目录复用本轮缓存。统计逻辑大小，包含隐藏文件与子目录，跳过链接。SMB 使用 Windows 已有权限；错误会标为部分完成或失败。"/>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Label Content="大小单位：" Target="{Binding ElementName=SizeUnitSelector}" VerticalAlignment="Center" Padding="0,0,8,0"/>
                <ComboBox x:Name="SizeUnitSelector" Width="120" Padding="8,4"
                          ItemsSource="{Binding SizeUnits}" SelectedItem="{Binding SelectedSizeUnit, Mode=TwoWay}"
                          IsEnabled="{Binding CanChangeSizeUnit}" ToolTip="全部路径处理结束后，可统一切换大小显示单位；CSV 使用相同单位。">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Static core:SizeUnit.Automatic}">
                                                <Setter Property="Text" Value="自动"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="全部检索结束后可用 · 1024 进制" Foreground="#63758D" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <DataGrid Grid.Row="3" x:Name="ResultsGrid" ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}" SelectionMode="Extended" SelectionUnit="FullRow"
                  Sorting="SortResults">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件夹路径" Binding="{Binding Path}" Width="*" MinWidth="220" SortMemberPath="Path"/>
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="SizeToCells" MinWidth="105" SortMemberPath="TotalBytes"/>
                <DataGridTextColumn Header="精确字节数" Binding="{Binding BytesText}" Width="135" SortMemberPath="TotalBytes"/>
                <DataGridTextColumn Header="文件数" Binding="{Binding FileCount, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="90" SortMemberPath="ElapsedSeconds"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                <DataGridTextColumn Header="错误" Binding="{Binding ErrorCount}" Width="65"/>
                <DataGridTextColumn Header="跳过" Binding="{Binding SkippedCount}" Width="65"/>
                <DataGridTextColumn Header="复用" Binding="{Binding CacheHitCount}" Width="65"/>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
        <Border Grid.Row="5" Background="White" BorderBrush="#DDE4EF" BorderThickness="1" CornerRadius="4" Padding="12">
            <DockPanel>
                <TextBlock Text="扫描详情" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <TextBox Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding BatchSummary}" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="{Binding Activity}" ToolTip="{Binding Activity}" TextTrimming="CharacterEllipsis" Foreground="#63758D" Margin="0,5,0,0"/>
        </Grid>
    </Grid>
</Window>
